#!/usr/bin/zsh

# ln -sfn "$(awww query -n wallpaper -j | jq -r '.[].[0].displaying.image')" ~/.config/current_wall
if [ "$#" -le 0 ]; then echo "pick an img"; exit 2; fi
[[ -f "$1" ]] && magick identify "$1" &>/dev/null || { echo "not an img"; exit 2; }

ln -sfn "${1:A}" ~/.config/current_wall
magick -monitor ~/.config/current_wall -blur 0x8 ~/.config/current_wall_blurred 
awww img -n wallpaper -t random --transition-duration 1 $1
awww img -n overview -t random --transition-duration 1 ~/.config/current_wall_blurred
