#!/bin/sh

echo "BOOSTRAP !!!"

yadm checkout /home/comet/

# yay
sudo pacman -S --needed git base-devel
git clone https://aur.archlinux.org/yay.git
cd yay
makepkg -si
cd ..
rm -rf yay

# network, bt, audio
yay -S bluez bluez-utils nmap traceroute wget wireplumber

# critical shell tools
yay -S zsh zsh-completions bat neovim ripgrep fzf zoxide eza

# devtools and non-critical shell tools
yay -S lazygit zsh-theme-powerlevel10k zsh-you-should-use zsh-patina-git nvm hyfetch fastfetch python3 task tenki

# desktop
yay -S niri bibata-cursor-theme-bin brightnessctl awww hypridle hyprlock polkit-kde-agent mako waybar wl-clipboard xdg-desktop-portal-gnome xdg-desktop-portal-gtk

# qt5-wayland qt5ct qt6-wayland qt6ct
# qt5-multimedia


# fonts
yay -S noto-fonts ttf-jetbrains-mono ttf-liberation ttf-nerd-fonts-symbols

# cancel iosevka if low space
printf "Install Iosevka? [Y/n] "
if ! read -r -t 30 answer; then
    answer="y"
    printf '\n'
fi

case "$answer" in
    ""|[Yy]|[Yy][Ee][Ss])
        yay -S ttc-iosevka ttc-iosevka-aile ttc-iosevka-etoile ttc-iosevka-slab ttc-iosevka-ss14
        ;;
    *)
        ;;
esac


# desktop non-critical
yay -S niri-screen-time-git niri-sidebar-git waybar-niri-windows-git

# desktop tools
yay -S kitty spotify zen-browser-bin rofi

# other deps
yay -S tree-sitter-cli python-gobject
